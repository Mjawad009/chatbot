# Leave QDRANT_URL unset for local dev — uses Qdrant's embedded on-disk mode,
# zero infra needed. Set both when pointing at a real Qdrant (self-hosted or
# Qdrant Cloud) instance in production.
QDRANT_URL=https://193a56ec-988d-4a12-bc3b-4834634a2386.eu-central-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=193a56ec-988d-4a12-bc3b-4834634a2386

# Required — shared secret between this service and the Node backend.
# Generate with: openssl rand -hex 32
KB_SERVICE_API_KEY=8b9e2d89d0d10dbeb64df5b8f6d6a6d03a09d14f55d5f54782f4e2b6c1b3a8e7

# Optional tuning
KB_CHUNK_SIZE=512
KB_CHUNK_OVERLAP=64
KB_MAX_FILE_SIZE_MB=25
KB_EMBED_MODEL=BAAI/bge-small-en-v1.5
