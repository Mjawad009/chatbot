# Point an A record for this subdomain at your Contabo VPS's IP BEFORE starting
# the containers — Caddy needs it resolvable to issue a real TLS certificate.
N8N_HOST=n8n.yourdomain.com

# Encrypts n8n's stored credentials (SMTP passwords, WhatsApp tokens, etc).
# Generate with: openssl rand -hex 24
# BACK THIS UP somewhere safe (password manager, etc) — if you lose it, every
# credential saved in n8n becomes unreadable and has to be re-entered.
N8N_ENCRYPTION_KEY=

TIMEZONE=Asia/Karachi
