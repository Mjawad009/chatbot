# KB Service — file upload/knowledge-base management. Leave unset if you
# haven't deployed the KB Service yet; the admin panel will show it as
# unavailable rather than erroring.
#
# If both this backend and kb-service are deployed in the same Railway
# project, point this at kb-service's INTERNAL Railway hostname (something
# like http://kb-service.railway.internal:PORT), not its public URL —
# internal traffic stays on Railway's private network (low single-digit ms)
# instead of round-tripping out to the public internet and back. This
# matters most on the live chat path (Section 6.4/12 of the architecture
# doc — the KB search call there is already timeout-limited, but a faster
# round trip means more of that budget is spent actually retrieving,
# not travelling).
KB_SERVICE_URL=
KB_SERVICE_API_KEY=

# Optional — Redis for shared state across instances (rate limiting, admin
# sessions, escalation/booking state). Unset = in-memory, fine for a single
# instance. Format: redis://[:password@]host:port or rediss:// for TLS.
REDIS_URL=

# Optional — Postgres for tenant config + leads/conversation history. Unset
# = tenants load from data/tenants/*.json (unchanged legacy behavior) and
# leads/conversations stay in logs/*.log only. Once set, run
# `node scripts/migrate-tenants-to-db.js` ONCE to migrate existing tenant
# JSON files into the DB — after that, the admin panel reads/writes tenants
# via Postgres and every save gets a versioned snapshot (see db/schema.sql).
# Apply db/schema.sql to a fresh database before first use.
DATABASE_URL=
# Set to "false" for a local/self-hosted Postgres without a real TLS cert
# (e.g. plain Docker Compose). Leave unset (defaults to a permissive TLS
# mode) for most managed providers (Railway, RDS, etc.).
DATABASE_SSL=

# Copy this file to .env and fill in your key
#
# Get a FREE key (no credit card required) at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Free-tier models (zero cost). Swap for any model at https://openrouter.ai/models
# Other good free options:
#   deepseek/deepseek-r1:free
#   google/gemini-2.0-flash-exp:free
#   qwen/qwen-2.5-72b-instruct:free
OPENROUTER_MODEL=
# Used for internal/background tasks (booking field extraction) — kept on a
# free model regardless of the primary chat model above, since these calls
# are never shown to the customer directly. Defaults to a free Llama model
# if unset.
OPENROUTER_INTERNAL_MODEL=

PORT=

# --- Per-tenant API keys (optional) ---
# If a tenant's JSON sets "provider": { "apiKeyEnv": "SOME_NAME" }, add that env var
# here with its own key. This lets each tenant's usage/billing be tracked separately
# on OpenRouter's side. Example:
ACME_OPENROUTER_KEY=

# --- Concurrency control (optional) ---
# Caps simultaneous in-flight requests against any single provider API key, so a burst
# of concurrent users doesn't all hit the free-tier rate limit at once. Extra requests
# queue briefly instead of firing all at once.
# MAX_CONCURRENT_PER_PROVIDER_KEY=3
# MAX_PROVIDER_QUEUE_WAIT_MS=8000

# Internal admin panel — only for you, not tenants. Both required or /admin
# and /api/admin/* respond 503. Set to your own values before deploying.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional — Slack incoming webhook (or similar) so escalation leads survive
# a Railway redeploy even without a persistent volume.
LEAD_WEBHOOK_URL=

# Optional — tune per-visitor rate limiting (requests/minute per IP+tenant).
RATE_LIMIT_PER_MINUTE=

# Optional — signs admin session cookies. If unset, a random secret is
# generated at boot (fine for one instance; every restart just logs you out).
# Set this once you're running more than one instance or want sessions to
# survive a restart. Any long random string works, e.g. `openssl rand -hex 32`.
ADMIN_SESSION_SECRET=
